	(text_box "Capacitor discharge circuit. Ensures capacitor is discharged after solenoid is turned off. \nVoltage drop across the flyback diodes triggers the PNP, which shorts the capacitor. Diode to limit voltage. Resistor to limit current.\nAdditional resistor to limit current through PNP."
		(exclude_from_sim no)
		(at 153.67 72.39 0)
		(size 46.99 13.97)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width -0.0001)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "c521e54a-618a-4279-a194-3f76b7bb8aba")
